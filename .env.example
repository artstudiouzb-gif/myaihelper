# ===== Telegram =====
# Токен от @BotFather
BOT_TOKEN=
# Ваш Telegram ID (узнать: @userinfobot). Несколько — через запятую: 111,222
ALLOWED_USER_IDS=

# Публичный HTTPS-адрес приложения.
# На Railway и Render можно не заполнять — определится автоматически.
# На VPS: https://ваш-домен
WEBAPP_URL=
# Только для VPS с docker-compose: домен без https://
DOMAIN=

# ===== Ключи API (раздел без ключа просто отключится) =====
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# ===== Модели (можно не менять) =====
CLAUDE_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2
GEMINI_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STS_MODEL=eleven_multilingual_sts_v2

# Максимальный размер загружаемого файла, МБ
MAX_UPLOAD_MB=200
