# ===== Telegram =====
# Токен от @BotFather
BOT_TOKEN=
# Ваш Telegram ID (узнать: @userinfobot). Несколько — через запятую: 111,222
ALLOWED_USER_IDS=

# Публичный HTTPS-адрес приложения.
# На Railway и Render можно не заполнять — определится автоматически.
# На VPS: https://ваш-домен
WEBAPP_URL=
# Только для VPS с docker-compose: домен без https://
DOMAIN=

# ===== Ключи API (раздел без ключа просто отключится) =====
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# ===== Модели (актуальны на октябрь 2026, можно не менять) =====
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING=medium
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_MODEL_HQ=gpt-image-2.5-sunburst
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_MODEL_PRO=gemini-3-pro-image
VEO_MODEL=veo-3.1-generate-001
VEO_FAST_MODEL=veo-3.1-fast-generate-001
OMNI_MODEL=gemini-omni-1.1-flash
ELEVENLABS_TTS_MODEL=eleven_v4
ELEVENLABS_TTS_FAST_MODEL=eleven_v4_turbo
ELEVENLABS_STS_MODEL=eleven_multilingual_sts_v2
ELEVENLABS_DUBBING_MODEL=dubbing_v2
ELEVENLABS_STT_MODEL=scribe_v2

# Максимальный размер загружаемого файла, МБ
MAX_UPLOAD_MB=200
